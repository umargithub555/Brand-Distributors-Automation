APP_NAME=Brand Intelligence API

# Docker Hub image settings
DOCKERHUB_USERNAME=yourdockerhubusername
APP_IMAGE_TAG=1.0.0

# MongoDB Atlas
MONGO_URL=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
MONGO_DB_NAME=BrandsDB

# Gemini
COMPANY_GEMINI_API_KEY=your_gemini_api_key_here
RESEARCH_MODEL=gemini-3-flash-preview
STRUCTURING_MODEL=gemini-3.1-flash-lite
RESEARCH_TIMEOUT_SECONDS=180
STRUCTURE_TIMEOUT_SECONDS=150

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@example.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM_EMAIL=your_email@example.com
SMTP_FROM_NAME=Brand Intelligence
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Redis / worker tuning
REDIS_URL=redis://redis:6379/0
OUTREACH_SEND_DELAY_SECONDS=45
OUTREACH_RETRY_DELAY_SECONDS=300
OUTREACH_MAX_ATTEMPTS=3
BRAND_PROCESSING_MAX_PARALLEL=2
OUTREACH_WORKER_MAX_PARALLEL=3
WORKER_MAX_JOBS=5
WORKER_JOB_TIMEOUT_SECONDS=1800

# Host ports
FRONTEND_PORT=8080
BACKEND_PORT=8000
